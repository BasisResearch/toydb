#
# Toolchain pins for the upstream proof gate, Basis statistics, and agents.
# .github/actions/setup-verus selects the Basis distribution for verus-verify
# and verus-coverage, and the upstream distribution for verus-gate. It records
# the installed toolchain versions on every telemetry datapoint.
#
# For the Basis refs, a branch name tracks that
# branch's head on every run (what `main` does below); a full commit sha
# freezes it. Everything else follows from the Verus commit: the binaries
# come from its basis-build release (`basis-<10-char sha>`), the Rust
# toolchain and pinned solvers from the release's version.json, and
# `verus-reach` is built from the same commit. Keep the vstd pin in
# Cargo.toml equal to the vstd version that Verus commit ships (the action
# warns when they drift).

# Official upstream release matching both Cargo.lock's vstd version and the
# Basis fork's Rust toolchain. The gate uses its bundled Z3 and the cvc5
# version in upstream tools/get-cvc5.sh. setup-upstream-verus.sh compensates
# for this release's cumulative cvc5 resource-limit bug at the process boundary.
UPSTREAM_VERUS_TAG=release/0.2026.08.30.b432e82
UPSTREAM_VERUS_SHA256=067f5f72a457fe66b77c0c10b180f2a919a9c7481a8baa024ffc716aa931a41b
UPSTREAM_VSTD_VERSION=0.0.0-2026-08-30-0159
UPSTREAM_CVC5_TAG=cvc5-1.1.2
UPSTREAM_CVC5_SHA256=cf291aef67da8eaa8d425a51f67f3f72f36db8b1040655dc799b64e3d69e6086

# BasisResearch/verus, for fork verification telemetry and reachability.
VERUS_REF=main
# BasisResearch/verus-tools-mcp, used only by the local agent launcher
# (.claude/bin/verus-mcp). CI calls cargo-verus directly and does not resolve
# this ref or report an MCP version.
VERUS_MCP_REF=main
