{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "SPDX-License-Identifier: MIT. Verus telemetry (Component 2): fail-closed MCP gate at SessionStart, fail-soft trace capture at Stop. Hook scripts live in .claude/hooks/. See .claude/hooks/README.md.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/verus_gate.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/verus_stop.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
