{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "SPDX-License-Identifier: MIT. Verus telemetry (Component 2): fail-closed MCP gate at SessionStart, fail-soft trace capture at Stop, SMT query capture at PostToolUse (smt_capture.py keys Verus --log-all artifacts to the tool call and uploads them), branch-discipline guard at PreToolUse (initials-prefixed branches, no direct commits/pushes to main). Hook scripts live in .claude/hooks/. See .claude/hooks/README.md.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/branch_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/verus_gate.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/verus_stop.py\"",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|mcp__verus__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/smt_capture.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
